# Basar Kassensystem - Beispiel-Konfiguration für Produktion
# Kopiere diese Datei zu `.env.production` und passe die Werte an

# Obligatorische Einstellungen
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=dein-mindestens-50-zeichen-random-schluessel-hier-ersetzen
DATABASE_URL=postgresql://basar_user:basar_password@10.10.9.80:5432/basar

# Optionale Einstellungen
# Host-Validierung: Wenn leer, akzeptiert Production alle Hosts (sicher nur mit Reverse-Proxy!)
# DJANGO_ALLOWED_HOSTS=10.10.9.80,basar.example.com
# Erforderlich für CSRF-geschützte Formulare über HTTPS via NGINX
DJANGO_CSRF_TRUSTED_ORIGINS=https://10.10.9.80

# Sicherheit: HTTPS und HSTS
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Datenbankverbindung: TLS für PostgreSQL (falls erforderlich)
# DATABASE_SSLMODE=require
# DATABASE_SSLCERT=/path/to/client-cert.pem
# DATABASE_SSLKEY=/path/to/client-key.pem
# DATABASE_SSLROOTCERT=/path/to/ca-cert.pem

# Logging
# Steuert die Verbosity von Django-Logs
# Erlaubte Werte: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DJANGO_LOG_LEVEL=INFO

# E-Mail (für Verifizierung und Benachrichtigungen)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=dein-email@example.com
# EMAIL_HOST_PASSWORD=dein-app-password
# DEFAULT_FROM_EMAIL=basar@example.com

# Statische Dateien und Media
# STATIC_ROOT=/var/www/basar/staticfiles
# MEDIA_ROOT=/var/www/basar/media
# PRIVATE_MEDIA_ROOT=/var/www/basar/private_media (für Settlement-PDFs)

# Zeitzone
# TZ=Europe/Berlin

# Sprache: Fallback-Sprache wenn Benutzer keine Sprache wählt
# LANGUAGE_CODE=de

# Datenbankverbindungs-Pool
# DATABASE_CONN_MAX_AGE=60
